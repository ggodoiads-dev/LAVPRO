# LAVPRO — variáveis de ambiente
# Copie para .env.local e preencha com os valores reais do seu projeto Supabase.

# Supabase ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxx

# Chave de service_role apenas no servidor; nunca exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxx

# App --------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LAVPRO

# Gateway de pagamento (Fase 4) -----------------------------------
# Enquanto não forem definidos, /api/webhooks/gateway responde 503 e o
# frontend NUNCA promove uma assinatura para "ativa" sozinho.
# GATEWAY_PROVIDER=stripe
# GATEWAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# GATEWAY_API_KEY=sk_xxxxxxxxxxxxxxxxxxxx

# Cron (Fase 5) ---------------------------------------------------
# Segredo compartilhado para proteger /api/cron/campanhas. Configure o
# mesmo valor no Scheduled Function/Vercel Cron.
# CRON_SECRET=xxxxxxxxxxxxxxxxxxxx
